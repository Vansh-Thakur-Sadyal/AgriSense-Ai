# Normalise text files; keep Linux line endings where the server or a Linux tool reads the file
* text=auto
*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
android/gradlew text eol=lf
*.bat       text eol=crlf

# Model and data files must never be touched by line-ending conversion
*.onnx     binary
*.joblib   binary
*.pt       binary
*.sqlite   binary
*.db       binary
app/models/yield_model.txt -text
*.png      binary
*.jpg      binary
*.jpeg     binary
*.woff2    binary
*.pdf      binary
